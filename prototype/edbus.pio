.pio_version 0                        ; These programs require version 0 (RP2040) features only.

.program edbus_tx
.side_set 1 opt pindirs               

error:
  irq wait 0
public reset:
  mov osr, null
.wrap_target
  pull
  wait 0 irq 7
  set pindirs, 0        [7] side 0
  set x, 7
write_word:
  pull ifempty
write_bit:
  out y, 1
  jmp !y write_zero
write_one:
  set pindirs, 1        [2] side 1
  jmp pin next_bit
  jmp error
write_zero:
  set pindirs, 0        [3] side 1
next_bit:
  jmp !osre write_bit       side 0
next_word:
  jmp x-- write_word
finish_write:
  set pindirs, 1        [7] side 1
.wrap

% c-sdk {

#include "hardware/clocks.h"
#include "hardware/gpio.h"

// edbus_tx_program_init intialises the edbus_tx program.
// pin_ebd and pin_ebc must be sequential: pin_ebc must be one after pin_ebd.
// The edbus_rx program must always be initalised prior to initailising the edbus_tx program for correct operation.
static inline void edbus_tx_program_init(PIO pio, uint sm, uint offset, uint pin_ebd, uint pin_ebc) {
    // EBC must be after EBD due to controlling EBC through side_set.
    assert(pin_ebc == pin_ebd + 1);
    // Create a new config based on the default options.
    pio_sm_config c = edbus_tx_program_get_default_config(offset);

    sm_config_set_set_pins(&c, pin_ebd, 1); // Make the 'set pins' and 'set pindirs' instructions manipulate the EBD pin.
    sm_config_set_jmp_pin(&c, pin_ebd); // Make the 'jmp pin' instruction read the state of the EBD pin.
    sm_config_set_sideset_pins(&c, pin_ebc); // Make the 'side 0' and 'side 1' side-set controls manipulate the EBC pin.

    // Join the RX and TX FIFO buffers into one large TX buffer, as this program only needs TX.
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX); 

    float div = (float)clock_get_hz(clk_sys) / (48 * 1000 * 1000);
    sm_config_set_clkdiv(&c, div);

    // Pull up both EBD and EBC.
    // 220Ω hardware resistors between EBD/EBC and 3.3V must be used in addition to this.
    // This makes both pins remain at logic level high by default, unless something drives them low.
    gpio_pull_up(pin_ebd);
    gpio_pull_up(pin_ebc);

    // Create a utility bitmask to control both EBD and EBC at the same time.
    uint32_t pin_mask = (1u << pin_ebd) | (1u << pin_ebc);

    // Pre-set EBD and EBC to output high, so that they don't glitch the bus when initialised.
    pio_sm_set_pins_with_mask(pio, sm, pin_mask, pin_mask); // Set both EBD and EBC high.
    pio_sm_set_pindirs_with_mask(pio, sm, pin_mask, pin_mask); // Set both EBD and EBC to direction 1 (currently the 'output' direction).

    // Initialise EBD and EBC.
    pio_gpio_init(pio, pin_ebd);
    pio_gpio_init(pio, pin_ebc);

    // Invert the output enable (direction) controls for EBD and EBC.
    // After this, direction 0 represents an output, and direction 1 represents an input.
    // As EBD and EBC are currently set to direction 1, applying this inversion makes both EBD and EBC become inputs.
    gpio_set_oeover(pin_ebd, GPIO_OVERRIDE_INVERT); 
    gpio_set_oeover(pin_ebc, GPIO_OVERRIDE_INVERT);

    // Pre-set EBD and EBC to low. This has no effect yet, as EBD and EBC are currently inputs.
    pio_sm_set_pins_with_mask(pio, sm, 0, pin_mask);

    // This setup allows operating the EBD and EBC pins as an 'open-drain' bus.
    // When EBD/EBC is set to direction 1, the pin becomes an input, so remains pulled up high by the pull-up resistors.
    // When EBD/EBC is set to direction 0, the pin becomes an output, and the pin is driven low.

    // The inversion of the direction controls is used to make the edbus_tx program easier to read.
    // 'set pindirs, 0' now drives EBD low, and 'set pindirs, 1' now leaves EBD high.

    // Initialise the state machine at the reset label.
    pio_sm_init(pio, sm, offset + edbus_tx_offset_reset, &c);
    // Enable the state machine.
    pio_sm_set_enabled(pio, sm, true);
}
%}

.program edbus_rx

public reset:
  mov isr, null
.wrap_target
  irq clear 7
  wait 0 pin 1
  irq set 7
  set x, 7
read_word:
  set y, 31
read_bit:
  wait 1 pin 1 [2]
  in pins, 1
next_bit:
  jmp y-- read_bit
next_word:
  push
  jmp x-- read_word
.wrap 

% c-sdk {

#include "hardware/clocks.h"

// edbus_rx_program_init intialises the edbus_rx program.
// pin_ebd and pin_ebc must be sequential: pin_ebc must be one after pin_ebd.
// The edbus_rx program must always be initalised prior to initailising the edbus_tx program for correct operation.
static inline void edbus_rx_program_init(PIO pio, uint sm, uint offset, uint pin_ebd, uint pin_ebc) {
    // EBC must be after EBD due to waiting on EBC through its relative pin index from EBD.
    assert(pin_ebc == pin_ebd + 1);
    // Create a new config based on the default options.
    pio_sm_config c = edbus_rx_program_get_default_config(offset);

    sm_config_set_in_pins(&c, pin_ebd); // Make the 'in pins' instruction read the state of the EBD pin.

    // Join the RX and TX FIFO buffers into one large RX buffer, as this program only needs RX.
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);

    float div = (float)clock_get_hz(clk_sys) / (48 * 1000 * 1000);
    sm_config_set_clkdiv(&c, div);

    // Initialise the state machine at the reset label.
    pio_sm_init(pio, sm, offset + edbus_rx_offset_reset, &c);
    // Enable the state machine.
    pio_sm_set_enabled(pio, sm, true);
}
%}
