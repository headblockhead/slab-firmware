.pio_version 0                    ; These programs use only features from 
                                  ; version 0, so are compatible with any
                                  ; rp2040 or greater PIO hardware.

.define public edbus_pio_clock (48 * 1000 * 1000) ; Run the edbus PIO state
                                                  ; machines at 48MHz.

.program edbus_tx                 ; The edbus_tx program begins here.

.side_set 1 opt pindirs           ; This program will optionally manipulate the
                                  ; state of 1 pin simultaneously with an
                                  ; instruction call. This is used here to
                                  ; control the state of the EBC (clock) pin.

error:                            ; The 'error' label is jumped to if a 
                                  ; transmission is abandoned.
  irq wait 0                      ; Set IRQ 0 to alert the CPU to the error, so 
                                  ; it can attempt retransmission,
                                  ; then wait for the CPU to clear the IRQ.

public entry_point:               ; The 'entry_point' label is where the 
                                  ; program begins.

.wrap_target                      ; When the .wrap position is reached,
                                  ; execution will continue from .wrap_target.

  pull                            ; Take one word (32 bits) from the TX FIFO
                                  ; and put it into the Output Shift Register
                                  ; (OSR). If there is no data available from 
                                  ; the TX FIFO, stall here until data becomes 
                                  ; available.

  wait 0 irq 7                    ; If IRQ 7 is not cleared, stall here until
                                  ; it is. IRQ 7 is controlled by the edbus_rx
                                  ; program, and is set whilst the bus is busy.

  set pindirs, 0      [7] side 0  ; Set EBD and EBC low, then wait another 7
                                  ; cycles. This indicates to all nodes on the
                                  ; bus that a transmission is about to begin.

  set x, 7                        ; Set register x to 7. Register x stores the
                                  ; number of words to be transmitted minus 1
                                  ; (8 - 1 = 7).
write_word:
  pull ifempty                    ; If all bits in the OSR have been consumed,
                                  ; take a word from the TX FIFO. Otherwise,
                                  ; proceed. If there is no data available 
                                  ; from the TX FIFO when attempting to take a
                                  ; word, stall here until data becomes 
                                  ; available. However, stalling here for a
                                  ; long time could be problematic, because the
                                  ; bus would be blocked until the stall ends. 
                                  ; To prevent this, all 8 words of each 
                                  ; message should be transferred to the TX FIFO
                                  ; as close together as possible.
write_bit:
  out y, 1                        ; Shift one bit out of the OSR, and write its
                                  ; value into the y register.

  jmp !y write_zero               ; If the y register is 0, jump to 
                                  ; 'write_zero'. Otherwise, fall through to
                                  ; 'write_one'.
write_one:
  set pindirs, 1      [2] side 1  ; Set EBD and EBC high, then wait another 2
                                  ; cycles. This communicates a '1' bit.

  jmp pin next_bit                ; Read the state of the EBD pin. If the pin
                                  ; is high, a '1' has been communicated 
                                  ; correctly, so jump to the 'next_bit' label.
                                  ; However, if the pin is low, another node 
                                  ; has likely started a transmission at the
                                  ; same time as this one, and is currently
                                  ; communicating a '0'. To avoid a collision,
                                  ; this node should cease transmission by
                                  ; falling through to the unconditional jump.

  jmp error                       ; Jump to the 'error' label. 
write_zero:
  set pindirs, 0      [3] side 1  ; Set EBD low, and EBC high, then wait 
                                  ; another 3 cycles. This communicates a '0'
                                  ; bit. A 3 cycle delay is used when writing
                                  ; a '0' bit so that 'write_one' and 
                                  ; 'write_zero' take the same amount of time
                                  ; to reach the 'next_bit' label.
next_bit:                        
  jmp !osre write_bit     side 0  ; Set EBC low, then unless all 32 bits in the
                                  ; OSR have been consumed, jump to the 
                                  ; 'write_bit' label. Otherwise, fall through.
next_word:
  jmp x-- write_word              ; If the x register is not 0, jump to
                                  ; 'write_word'. Otherwise, fall through.
                                  ; Then, in either case, decrement x.

  set pindirs, 1      [7] side 1  ; Set EBD and EBC high, then wait another 7
                                  ; cycles. This indicates to all nodes on the
                                  ; bus that the transmission has ended.
                                  
.wrap                             ; Wrap back to the .wrap_target position.

% c-sdk {

#include "hardware/clocks.h"
#include "hardware/gpio.h"

// edbus_tx_program_init initialises the edbus_tx program.
// pin_ebd and pin_ebc must be sequential: pin_ebc must be 1 after pin_ebd.
static inline void edbus_tx_program_init(PIO pio, uint sm, uint offset, 
                                         uint pin_ebd, uint pin_ebc) {
    // EBC must be 1 after EBD, as it is referenced by its relative position
    // from EBC in the edbus_rx assembly program.
    assert(pin_ebc == pin_ebd + 1);

    // Create a new state machine config.
    pio_sm_config c = edbus_tx_program_get_default_config(offset);

    // Assign the EBD pin to the 'set pins' and 'set pindirs' instructions.
    sm_config_set_set_pins(&c, pin_ebd, 1); 
    // Make the 'jmp pin' instruction read the state of the EBD pin.
    sm_config_set_jmp_pin(&c, pin_ebd); 
    // Assign the EBC pin to the 'side 0' and 'side 1' side-set controls.
    sm_config_set_sideset_pins(&c, pin_ebc);

    // Join the 4 word deep RX and TX FIFO buffers into one large 8-deep 
    // TX FIFO buffer, as this program only uses TX.
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX); 

    // Divide the current system clock speed by the edbus_pio_clock value 
    // to calculate a clock divider value.
    float div = (float)clock_get_hz(clk_sys) / edbus_pio_clock;
    // Then apply the calculated value to the state machine's clock divider.
    // This ensures the state machine running the edbus_tx program is always
    // operating at approximately the speed specified as edbus_pio_clock, as
    // long as the system clock speed remains constant after
    // edbus_tx_program_init is called.
    sm_config_set_clkdiv(&c, div);

    // Pull up both EBD and EBC.
    // 2.2kΩ hardware resistors between EBD/EBC and 3.3V must be used in 
    // addition to the GPIO's built-in pullups. This makes both pins remain at
    // logic level high by default, unless something drives them low.
    gpio_pull_up(pin_ebd);
    gpio_pull_up(pin_ebc);

    // Create a utility bitmask to control both EBD and EBC at the same time.
    uint32_t pin_mask = (1u << pin_ebd) | (1u << pin_ebc);

    // Pre-set EBD and EBC to logic high, so that they don't glitch the bus 
    // when initialised.
    pio_sm_set_pins_with_mask(pio, sm, pin_mask, pin_mask); 
    // Set both EBD and EBC to direction 1 (currently the 'output' direction).
    pio_sm_set_pindirs_with_mask(pio, sm, pin_mask, pin_mask); 

    // Initialise EBD and EBC.
    pio_gpio_init(pio, pin_ebd);
    pio_gpio_init(pio, pin_ebc);

    // Invert the output enable (direction) controls for EBD and EBC.
    // After this, direction 0 represents an output, and direction 1 represents
    // an input. As EBD and EBC are currently set to direction 1,
    // applying this inversion makes both EBD and EBC become inputs.
    gpio_set_oeover(pin_ebd, GPIO_OVERRIDE_INVERT); 
    gpio_set_oeover(pin_ebc, GPIO_OVERRIDE_INVERT);

    // Pre-set EBD and EBC to logic low.
    // This has no effect yet, as EBD and EBC are currently inputs.
    pio_sm_set_pins_with_mask(pio, sm, 0, pin_mask);

    // This setup allows operating the EBD and EBC pins as an 'open-drain' bus.
    // When EBD/EBC is set to direction 1, 
    // the pin becomes an input,
    // so remains pulled up high by the pull-up resistors.
    // When EBD/EBC is set to direction 0, 
    // the pin becomes an output,
    // and so the pin is driven low.

    // The inversion of the direction controls is used to make the edbus_tx 
    // program easier to read.
    // For example, because of this inversion,
    // 'set pindirs, 0' drives EBD low, 
    // and 'set pindirs, 1' leaves EBD high.

    // Initialise the state machine at the entry_point label.
    pio_sm_init(pio, sm, offset + edbus_tx_offset_entry_point, &c);
    // Enable the state machine.
    pio_sm_set_enabled(pio, sm, true);
}
%}

.program edbus_rx                 ; The edbus_rx program begins here.

reset:
.wrap_target                      ; When the .wrap position is reached,
                                  ; execution will continue from .wrap_target.
  irq clear 7                     ; Clear IRQ 7. This indicates to edbus_tx
                                  ; that the bus is currently inactive.
wait_start:
  wait 0 pin 1                    ; Wait for EBC to go low, potentially 
                                  ; indicating a start condition.

  irq set 7                       ; Set IRQ 7 to prevent edbus_tx from starting
                                  ; a transmission whilst the bus is busy.

  set x, 7            [1]         ; Prepare register x with the value 7.
                                  ; Register x stores the number of words to be
                                  ; received minus 1 (8 - 1 = 7).
                                  ; Then, wait another cycle so that the next
                                  ; instruction is correctly timed.

  jmp pin wait_end    [1]         ; If EBC is now high, three cycles after it
                                  ; was detected as low, this is not the start
                                  ; of a transmission, but somewhere in the
                                  ; middle, so jump to the 'wait_end' label to
                                  ; wait for the current transmission to end.
                                  ; Otherwise, this is the start of a
                                  ; transmission, so continue. Then, in either 
                                  ; case, wait another cycle. 
read_word:
  set y, 31                       ; Set register y to 31. Register y stores the
                                  ; number of bits to be received minus 1
                                  ; (32 - 1 = 31).
read_bit:
  wait 1 pin 1        [2]         ; Wait for EBC to go high, then wait another
                                  ; 2 cycles. The extra two-cycle gives the EBD
                                  ; line time to stabilise before its value is
                                  ; read.

  in pins, 1                      ; Read the state of the EBD pin, and shift
                                  ; its value (one bit) into the Input Shift
                                  ; Register (ISR).
next_bit:
  jmp y-- read_bit                ; If the y register is not 0, jump to the
                                  ; 'read_bit' label. Otherwise, fall through.
                                  ; Then, in either case, decrement y.
next_word:
  push noblock                    ; Take one word (32 bits) from the ISR and
                                  ; put it into the RX FIFO. If the RX FIFO is
                                  ; full, do not stall, just discard the data
                                  ; and continue. Stalling is prohibited here,
                                  ; as maintaining correct timing whilst
                                  ; reading from the bus is critical.

  jmp x-- read_word               ; If the x register is not 0, jump to the
                                  ; 'read_word' label. Otherwise, fall through
                                  ; to the wrap. Then, in either case,
                                  ; decrement x.

.wrap                             ; Wrap back to the .wrap_target position.

wait_end:
  wait 1 pin 1        [3]         ; Wait for EBC to go high, then wait another
                                  ; 3 cycles.

  jmp pin reset                   ; If the EBC pin is still high, three cycles
                                  ; after it was detected as high, this is the 
                                  ; end of a transmission, so jump back to the
                                  ; 'reset' label. Otherwise, fall through to
                                  ; the unconditional jump.

  jmp wait_end                    ; Jump back to the 'wait_end' label.

% c-sdk {

#include "hardware/clocks.h"

// edbus_rx_program_init initialises the edbus_rx program.
// pin_ebd and pin_ebc must be sequential: pin_ebc must be 1 after pin_ebd.
static inline void edbus_rx_program_init(PIO pio, uint sm, uint offset, 
                                         uint pin_ebd, uint pin_ebc) {
    // EBC must be 1 after EBD, as it is referenced by its relative position
    // from EBC in the edbus_rx assembly program.
    assert(pin_ebc == pin_ebd + 1);

    // Create a new state machine config.
    pio_sm_config c = edbus_rx_program_get_default_config(offset);

    // Assign the EBD pin to the 'in pins' instruction.
    sm_config_set_in_pins(&c, pin_ebd); 
    // Make the 'jmp pin' instruction read the state of the EBC pin.
    sm_config_set_jmp_pin(&c, pin_ebc); 

    // Join the 4 word deep RX and TX FIFO buffers into one large 8-deep 
    // RX FIFO buffer, as this program only uses RX.
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);

    // Divide the current system clock speed by the edbus_pio_clock value 
    // to calculate a clock divider value.
    float div = (float)clock_get_hz(clk_sys) / edbus_pio_clock;
    // Then apply the calculated value to the state machine's clock divider.
    // This ensures the state machine running the edbus_rx program is always
    // operating at approximately the speed specified as edbus_pio_clock, as
    // long as the system clock speed remains constant after
    // edbus_rx_program_init is called.
    sm_config_set_clkdiv(&c, div);

    // Initialise the state machine at the start of the program.
    pio_sm_init(pio, sm, offset, &c);
    // Enable the state machine.
    pio_sm_set_enabled(pio, sm, true);
}
%}
